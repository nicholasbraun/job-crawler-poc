# .env.example -- copy to `.env` and adjust. The app runs without a .env at all;
# every value below is the code's built-in default except LLM_API_KEY (needed for
# the LLM classifier/extractor). This file is loaded two ways:
#   1. Local `go run ./cmd/server` reads it via godotenv, which sees EVERY knob below.
#   2. `docker compose up` substitutes ${VAR} references in docker-compose.yml from it
#      -- and only a knob LISTED THERE reaches the container. Today that is the LLM_*
#      knobs, DESCRIPTION_MAX_CHARS, EXTRACT_FROM_JSONLD, SHADOW_EXTRACT_RATE,
#      EXTRACT_REQUIRE_POSITIVE_EVIDENCE, CRAWL_MAX_WORKERS, and LOG_LEVEL.
# So CRAWL_VISITED_CAP, ROBOTS_CACHE_*, and COLLECTION_* below are read by local `go
# run` only: setting them in .env has NO effect under Docker until they are added to
# docker-compose.yml's environment list. Add a knob in both places or in neither.
# Note: in Docker, DATABASE_URL and REDIS_ADDR are set to the compose service names
# directly and IGNORE the values here -- the localhost defaults below apply to local
# `go run` only.

# --- Datastores (local `go run`; Docker overrides with service names) ---
DATABASE_URL=postgres://crawler:crawler@localhost:5432/crawler?sslmode=disable
REDIS_ADDR=localhost:6379

# --- LLM classifier / extractor (OpenAI-compatible chat-completions API) ---
# LLM_API_KEY is required for the career-page classifier + job-listing extractor.
# Leave BASE_URL/MODEL at the OpenRouter defaults, or point them at a local server
# (e.g. Ollama). Locally prefer a non-reasoning instruct model -- a reasoning model
# spends a hidden think phase the crawler discards.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=mistralai/mistral-nemo
# A long per-request timeout and few workers suit a serial local model; raise both
# for a fast, highly-parallel cloud API. LLM_MAX_WORKERS sizes the durable LLM
# stage's consumer group (goroutines draining the per-run Redis Stream), not an
# in-process pool.
LLM_TIMEOUT=5m
LLM_MAX_WORKERS=2
# Cap the page text sent to each LLM call, keeping a local model fast. These are
# LATENCY dials for the prompt window -- they bound what the model READS, never what
# the Corpus stores (see DESCRIPTION_MAX_CHARS below).
LLM_CLASSIFY_MAX_CHARS=1500
LLM_EXTRACT_MAX_CHARS=8000

# --- Corpus (ADR-0041) ---
# Cap (runes) on the stored Posting Body -- a Job Listing's description, taken from the
# page's own text. Its own knob, deliberately NOT LLM_EXTRACT_MAX_CHARS above: tuning
# the prompt window for a local model must never change what is stored. This is a
# row-size guard against a pathological parse (59k characters observed live), sitting
# well above the ~12k p99 of real postings, so it only fires on a bad page.
DESCRIPTION_MAX_CHARS=16000

# --- Extraction (ADR-0042) ---
# Free Extraction: a page publishing exactly one structured-data JobPosting, no
# openings index and a non-empty title is saved from that data with NO model call.
# On by default. Set false to unwrap the decorator and restore the model-only extract
# path exactly -- the kill switch for the one path that can save a Job Listing with no
# model in the loop. Also set it false while harvesting the Extract Gold Set, so the
# captured accept verdicts are the model's rather than the pipeline's.
EXTRACT_FROM_JSONLD=true

# --- Shadow Extraction (ADR-0044) ---
# Fraction of Extract-Gate-rejected pages extracted anyway, purely to measure how
# often the gate throws away a real posting -- the only instrument that can see that
# failure at all, and it is permanent when it happens. ~1% of ~300k daily gate skips
# is about eight cents a day. A Shadow Extraction can never reach the Corpus: it runs
# on its own stream, in a processor built with no Corpus repository. Set 0 to switch
# the mechanism off entirely.
SHADOW_EXTRACT_RATE=0.01

# --- Extract Gate: Positive Evidence (ADR-0044) ---
# A page that clears every reject rung reaches the extractor only on evidence that it
# IS one posting -- a posting-shaped URL, a lone structured posting, a title
# announcing one vacancy, or enough of a posting's sections -- rather than merely
# because nothing rejected it. On by default since #264: measured over the Extract
# Gold Set it cuts the extract bill to ~14% of today's while leaving recall over real
# postings unmoved. Set false to restore the pre-ADR-0044 blanket accept exactly.
# This is the dial to pull if SHADOW_EXTRACT_RATE above starts reporting real postings
# among the pages the gate rejects -- a dropped posting is permanent, so it is a dial
# rather than a deploy.
EXTRACT_REQUIRE_POSITIVE_EVIDENCE=true

# --- Crawl ---
# Per-run crawl worker pools (discovery). Crawl workers are I/O-bound,
# so this can be raised well past the default once the frontier is no longer the
# bottleneck; watch the Postgres pool and outbound network next.
CRAWL_MAX_WORKERS=50
# Per-run ceiling on the visited ZSET's cardinality (ADR-0027 / #75).
CRAWL_VISITED_CAP=5000000

# --- robots.txt cache (ADR-0032) ---
# How many hosts' parsed rules are held, and for how long before a re-fetch, so the
# shared cache cannot grow without limit across a discovery crawl that touches tens
# of thousands of hosts.
ROBOTS_CACHE_SIZE=16384
ROBOTS_CACHE_TTL=1h

# --- Logging ---
# One of DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO

# --- Go runtime (optional; docker-compose sets this for the container) ---
# Soft heap ceiling Go's GC respects. The crawler container sets GOMEMLIMIT=1700MiB
# (sized to its 2g mem_limit) in docker-compose.yml. Leave it unset for local `go
# run` unless you want to reproduce the container's GC backpressure locally.
# GOMEMLIMIT=1700MiB

# --- Collection (ADR-0036) ---
# How often a Collection Cycle runs (Go duration). Default 24h.
COLLECTION_INTERVAL=24h
# Set false to disable the automatic collection scheduler. Default true.
COLLECTION_ENABLED=true
