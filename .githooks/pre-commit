#!/usr/bin/env bash
# Commit gate. Runs the cheap CI checks -- gofmt, go build, golangci-lint -- on the
# snapshot being committed (the index, not the working tree) and aborts the commit
# when one fails. Enable it once per clone:
#
#     git config core.hooksPath .githooks        (or: make hooks)
#
# Git runs this for `git commit` however it is spelled and from whichever
# worktree, and .githooks/pre-merge-commit runs it for merge commits. It only
# exists on checkouts that contain this file: a branch cut before the gate was
# added commits unchecked. `go test -race` is deliberately not here: it needs
# Docker and takes minutes, so it stays with the committer and CI.
#
# Each run appends one line to <git-common-dir>/commit-gate.log.
set -u -o pipefail

common_dir=""
log() {
	[ -n "$common_dir" ] || return 0
	printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${root:-?}" >>"$common_dir/commit-gate.log" 2>/dev/null || true
}
die() {
	log "error($1)"
	echo "commit gate: $1" >&2
	exit 1
}

root=$(git rev-parse --show-toplevel) || die "not inside a work tree"
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd) || die "cannot locate the git directory"

# The commit's changes are the index against HEAD, or against the empty tree on a
# branch with no commit yet.
if git rev-parse --verify -q HEAD >/dev/null; then
	base=HEAD
else
	base=$(git hash-object -t tree /dev/null)
fi

# The checks can only change their verdict when the commit touches a Go file, the
# module or lint configuration, or any file inside a directory tree that holds Go
# code -- such a file may be a go:embed target, and removing one breaks the build.
# Whenever this cannot be worked out, run the checks rather than skip them.
relevant=""
if changed=$(git -c core.quotepath=off diff --cached --name-only --no-renames "$base") &&
	go_dirs=$(git ls-files -- '*.go' | awk -F/ 'NF == 1 { print "."; next } { sub(/\/[^\/]+$/, ""); print }' | sort -u); then
	if [ -n "$changed" ]; then
		relevant=$(printf '%s\n' "$changed" | GO_DIRS="$go_dirs" awk '
			BEGIN { n = split(ENVIRON["GO_DIRS"], d, "\n"); for (i = 1; i <= n; i++) if (d[i] != "") in_go[d[i]] = 1 }
			/\.go$/ || $0 == "go.mod" || $0 == "go.sum" || $0 == ".golangci.yml" { print; next }
			{
				p = $0
				while (sub(/\/[^\/]+$/, "", p)) if (p in in_go) { print $0; next }
				if ("." in in_go) print $0
			}') || relevant="(filter failed)"
	fi
else
	relevant="(could not list the commit's paths)"
fi
if [ -z "$relevant" ]; then
	log "skip(no-go-change)"
	exit 0
fi

command -v go >/dev/null 2>&1 && command -v gofmt >/dev/null 2>&1 ||
	die "go and gofmt must be on PATH for the commit gate to run"
command -v golangci-lint >/dev/null 2>&1 ||
	die "golangci-lint is not installed (brew install golangci-lint); the gate will not pass without it"

# Check what is staged, not what is on disk: export the index to a directory of its
# own. One fixed directory per repository keeps the build and lint caches warm and
# every cached path valid; the lock makes concurrent commits from several
# worktrees take turns, and the snapshot is removed when the run ends.
tmp=$(cd "${TMPDIR:-/tmp}" 2>/dev/null && pwd) || die "no usable temporary directory"
work="$tmp/commit-gate-$(printf '%s' "$common_dir" | cksum | cut -d ' ' -f 1)"
case "$work" in
/*/commit-gate-[0-9]*) ;;
*) die "refusing to use work directory '$work'" ;;
esac
snap="$work/snapshot"
lock="$work/lock"
umask 077
mkdir -p "$work" || die "cannot create $work"

waited=0
until mkdir "$lock" 2>/dev/null; do
	holder=$(cat "$lock/pid" 2>/dev/null || true)
	if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
		rm -rf "$lock" # its owner is gone
		continue
	fi
	[ "$waited" -lt 600 ] || die "another commit gate run has held $lock for ten minutes; remove it if it is stale"
	sleep 1
	waited=$((waited + 1))
done
echo $$ >"$lock/pid"
trap 'rm -rf "$snap" "$lock"' EXIT

rm -rf "$snap"
mkdir "$snap" && git checkout-index -a -f --prefix="$snap/" || die "could not export the staged snapshot to $snap"

# A hook inherits GIT_DIR, GIT_INDEX_FILE and the like; the tools below must not.
unset $(git rev-parse --local-env-vars)
cd "$snap" || die "cannot enter $snap"
# A cache of its own, so a cached finding never points into some other tree.
export GOLANGCI_LINT_CACHE="$work/lintcache"

fail() {
	log "block($1)"
	{
		echo "commit gate: $1 failed on the staged snapshot -- fix it, stage the fix, then commit again."
		echo "These are the same checks CI runs; paths are relative to the repo root."
		echo
		printf '%s\n' "$2" | head -n 80
	} >&2
	exit 1
}

out=$(gofmt -l . 2>&1)
[ -z "$out" ] || fail "gofmt -l" "Not gofmt-formatted (run gofmt -w on these):
$out"

out=$(go build ./... 2>&1) || fail "go build ./..." "$out"

# Serial runners: a second golangci-lint waits for the first instead of failing on
# its lock.
out=$(golangci-lint run --allow-serial-runners ./... 2>&1) || fail "golangci-lint run ./..." "$out"

log "pass"
exit 0
