{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["llm", "crawler"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LLM Telemetry",
  "uid": "llm-telemetry",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 1,
      "title": "LLM calls (selected range)",
      "description": "Total completed LLM calls over the dashboard time range, split by kind.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (increase(crawler_llm_calls_total[$__range]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Pages resolved without an LLM call, by reason (range)",
      "description": "Gate resolutions over the range, split by reason — never read as one number. structured_data is a Free Extraction (ADR-0042): a Job Listing SAVED with no model call. Every other reason (certain, irrelevant, url_structure) means the page was SHED and nothing was saved.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (increase(crawler_llm_gated_total[$__range]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Gate rate",
      "description": "Share of gate decisions resolved without an LLM call: gated / (gated + called). Higher means more cost avoided. Since ADR-0042 its numerator mixes two opposite outcomes — pages shed and pages saved for free — so read it beside the by-reason split.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_gated_total[$__range])) / clamp_min(sum(increase(crawler_llm_gated_total[$__range])) + sum(increase(crawler_llm_calls_total[$__range])), 1)",
          "legendFormat": "gate rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Call failure rate",
      "description": "Share of LLM calls that ended in error or timeout over the range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_calls_total{outcome=~\"error|timeout\"}[$__range])) / clamp_min(sum(increase(crawler_llm_calls_total[$__range])), 1)",
          "legendFormat": "failure rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Throughput & latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "LLM call rate",
      "description": "Completed LLM calls per second, by kind and outcome.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind, outcome) (rate(crawler_llm_calls_total[$__rate_interval]))",
          "legendFormat": "{{kind}} · {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "LLM call latency",
      "description": "Latency percentiles of LLM calls, computed from the duration histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(crawler_llm_call_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crawler_llm_call_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(crawler_llm_call_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Cost gating & content dedup",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Calls avoided, by gate reason",
      "description": "Rate of pages short-circuited before the LLM, split by the heuristic that resolved them (certain, irrelevant, url_structure, structured_data). structured_data is the odd one out: it is a Free Extraction (ADR-0042) that SAVED a Job Listing with no model call, while every other reason shed the page and saved nothing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(crawler_llm_gated_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Content fed to LLM: unique vs duplicate",
      "description": "Rate of page content sent to the LLM, split by whether identical content had been seen before (the duplicate-content probe).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duplicate" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "unique" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(crawler_llm_content_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Empty-Extraction Rate (model path)",
      "description": "Share of MODEL extract calls that ended in an Extractor Abstain (abstain / sent). Since ADR-0042 this covers model-path extractions ONLY: a Free Extraction is recorded as a gate resolution, never a call, so it never enters this rate. Read it as wasted model spend — NOT as Corpus-wide precision.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_calls_total{kind=\"extract\",outcome=\"abstain\"}[$__range])) / clamp_min(sum(increase(crawler_llm_calls_total{kind=\"extract\"}[$__range])), 1)",
          "legendFormat": "empty-extraction rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Reliability & durable queue",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Retries & dead-letters",
      "description": "Durable-stage redeliveries (reclaimed pending entries) and tasks moved to the dead-letter stream after exhausting attempts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^deadletter/" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(crawler_llm_retries_total[$__rate_interval]))",
          "legendFormat": "retry · {{kind}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(crawler_llm_deadletter_total[$__rate_interval]))",
          "legendFormat": "deadletter · {{kind}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Durable queue depth",
      "description": "Outstanding stream entries (backlog) and delivered-but-unacked entries (pending) per kind. Backlog growing without bound means the LLM stage cannot keep up.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^pending/" },
            "properties": [ { "id": "custom.fillOpacity", "value": 0 } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (crawler_llm_queue_depth)",
          "legendFormat": "backlog · {{kind}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (crawler_llm_queue_pending)",
          "legendFormat": "pending · {{kind}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "Shadow Extraction (live false-drop)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "False-drop rate (live)",
      "description": "Share of the pages the Extract Gate REJECTED that the extractor nevertheless reads as a single job posting (ADR-0044). Measured by extracting a sampled fraction of gate skips (SHADOW_EXTRACT_RATE, default 1%) purely to score the gate — nothing sampled here is ever saved to the Corpus. Denominator is completed verdicts only; an errored sample produced no verdict. A false-drop is permanent, so a rise here is the signal to loosen the gate. This number POOLS every gate rung: read \"False-drop rate by gate rung\" below before acting on it, because only the positive_evidence share is what EXTRACT_REQUIRE_POSITIVE_EVIDENCE=false would recover. Check \"Shadow samples shed\" too — a non-zero shed count means this rate was computed over an incomplete sample.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_shadow_total{verdict=\"accept\"}[$__range])) / clamp_min(sum(increase(crawler_llm_shadow_total{verdict=~\"accept|abstain\"}[$__range])), 1)",
          "legendFormat": "false-drop rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 13,
      "title": "LLM calls incl. Shadow Extraction (range)",
      "description": "Total model spend: real extract/classify calls plus Shadow Extractions. Shadow calls are deliberately kept OFF crawler_llm_calls_total — folding them in would corrupt the call rate the Extract Gate is judged by — so the cost view sums the two counters here.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(crawler_llm_calls_total[$__range])) + sum(increase(crawler_llm_shadow_total[$__range]))",
          "legendFormat": "calls incl. shadow",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Shadow Extractions by verdict",
      "description": "Rate of Shadow Extractions split by the extractor's verdict — accept (a false-drop), abstain (the gate was right), error (no verdict; the sample was lost). A flat zero while the walk is running means the lane is off or wedged.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (verdict) (rate(crawler_llm_shadow_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 15,
      "title": "False-drop rate by gate rung (range)",
      "description": "The same false-drop rate as the stat above, split by the Extract Gate rung that rejected the page. This split is what makes the number actionable: only the positive_evidence share is what EXTRACT_REQUIRE_POSITIVE_EVIDENCE=false would recover — a rate driven by job_link_saturation, openings_index or any other reject rung would survive that revert untouched, so reading the pooled number alone can send a rollback after a cause it does not fix. An \"unknown\" bar is a sample enqueued before the attribution existed and redelivered after an upgrade; it should fall to zero within a Cycle.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by (rung) (increase(crawler_llm_shadow_total{verdict=\"accept\"}[$__range])) / clamp_min(sum by (rung) (increase(crawler_llm_shadow_total{verdict=~\"accept|abstain\"}[$__range])), 1)",
          "legendFormat": "{{rung}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Shadow samples shed before measurement, by rung",
      "description": "Sampled gate-rejected pages the Shadow Extraction lane never measured: its durable stream was at its backlog cap when the walk tried to enqueue them. This is the trustworthiness of the false-drop rate's DENOMINATOR — sampling is uniform over rejected pages, but shedding is not (a full stream sheds whatever arrives while it is full), so any non-zero line here means the rate above is an estimate over a subsample nobody can characterize. Fix by lowering SHADOW_EXTRACT_RATE, or by raising the lane's sizing constants (shadowMaxBacklog / shadowMaxWorkers in cmd/server/main.go) — not by ignoring it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (rung) (rate(crawler_llm_shadow_dropped_total[$__rate_interval]))",
          "legendFormat": "{{rung}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 105,
      "title": "Learned Veto (ADR-0049)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 }
    },
    {
      "type": "stat",
      "id": 17,
      "title": "Extract calls the Learned Veto saved (range)",
      "description": "Pages the Extract Gate's final rung withheld from the LLM extractor: each one carried Positive Evidence, but its Posting Score fell below the compiled-in threshold (ADR-0049). Every page counted here is an extractor call not made, which is what this rung is FOR. It has its own gated reason rather than being pooled into url_structure, because it is the one rung a single environment variable restores — pooled with every structural reject, the cost of pulling EXTRACT_LEARNED_VETO could not be read at all. Zero and flat until EXTRACT_LEARNED_VETO=true; the `or vector(0)` shows an explicit 0 rather than \"No data\" before the first veto lands.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(crawler_llm_gated_total{kind=\"extract\",reason=\"learned_veto\"}[$__range])) or vector(0)",
          "legendFormat": "calls saved",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 18,
      "title": "Veto depth — share of judged pages vetoed (range)",
      "description": "The live, stream-weighted counterpart of the condition ADR-0049 registered BEFORE the measurement: the Learned Veto is worth its weights table only if it vetoes at least 10% of the Positive Evidence rung's accepts. Numerator is the calls saved; denominator is the Posting Score histogram's count, which is every page the rung actually judged — its vetoes AND its survivors. The training run measured 28.2% on the Extract Gold Set, in sample. A live number far from that is the first sign the walked stream does not look like the set the weights were fitted on; read the two distribution panels below before acting on it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_gated_total{kind=\"extract\",reason=\"learned_veto\"}[$__range])) / clamp_min(sum(increase(crawler_llm_posting_score_count[$__range])), 1)",
          "legendFormat": "veto depth",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 19,
      "title": "Learned Veto false-drop rate (live)",
      "description": "The false-drop rate restricted to the Learned Veto's rung: the share of the pages IT dropped that the extractor nevertheless reads as a single job posting. This is the rung's ONLY risk — it can never add a call, so all of its downside sits here. The series is primed at zero by PrimeShadow, so the FIRST accept is visible to increase() rather than reading as no change at all. It is also the one rung that cannot explain a drop in words: the matching log line carries the Posting Score that caused each one (grep posting_score). Denominator is completed verdicts only; an errored sample produced none.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(crawler_llm_shadow_total{verdict=\"accept\",rung=\"learned_veto\"}[$__range])) / clamp_min(sum(increase(crawler_llm_shadow_total{verdict=~\"accept|abstain\",rung=\"learned_veto\"}[$__range])), 1)",
          "legendFormat": "false-drop rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 20,
      "title": "Posting Score distribution (cumulative, range)",
      "description": "The empirical CDF of the Posting Score over every page the Learned Veto judged — the ones it kept as well as the ones it vetoed (ADR-0049). Recording only the vetoes would show where the cut is without showing what it is cutting into. Each bar is the count at or below its boundary, so the STEP between two bars is the density there. The cut sits at 0.605395: the bars up to that boundary are, to within one 0.05-wide band, what the veto removes. A cut landing in a steep step means small threshold moves have large effects on spend. The Posting Score is never a metric label value — these are the histogram's own buckets, which cost no series on any counter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (le) (increase(crawler_llm_posting_score_bucket[$__range]))",
          "legendFormat": "≤ {{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Posting Score quantiles",
      "description": "The same distribution over time, which is the drift detector this instrument exists to be. The threshold line at 0.605395 draws where the cut sits inside it. The weights were fitted on the Extract Gold Set, so if p50 walks away from where it sat when they were fitted, the operating point is being applied to a population it was never measured on and the 28.2% in-sample veto depth stops meaning what it meant. The bucket ladder behind these quantiles is fixed and deliberately NOT pinned to the threshold: a boundary that moved with every refit would silently re-bucket every historical series and destroy exactly this comparison.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 0.605395 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.10, sum by (le) (rate(crawler_llm_posting_score_bucket[$__rate_interval])))",
          "legendFormat": "p10",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(crawler_llm_posting_score_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(crawler_llm_posting_score_bucket[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "C"
        }
      ]
    }
