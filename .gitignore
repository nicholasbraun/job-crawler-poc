.DS_Store
.env
.*.env

# Go build output (see Makefile server-build)
/bin/

# llmbench local A/B run artifacts (bench -json output, diffed across runs)
/cmd/llmbench/results/

# Live-captured Extract Gold Set from the extract-decision tap (#116): raw pages
# harvested via scripts/capture-goldset.sh, curated before any land in the
# committed extract-testdata set.
/cmd/llmbench/extract-goldset-live/

# Extract-capture experiment (#116): local-only compose override + the captured
# JSONL bind-mount output. Both are working artifacts, never committed.
/docker-compose.override.yml
/capture/

# stray binary from `go build ./cmd/llmbench` (the Makefile builds to /bin)
/llmbench

# Node / Vite
web/node_modules/

# tsc build artifacts (vite reads vite.config.ts directly)
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Built frontend assets — but keep the committed placeholder so the Go embed
# compiles before the first `vite build`.
web/dist/*
!web/dist/index.html
